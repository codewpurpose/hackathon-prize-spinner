RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=CodeWithPurpose <spins@your-verified-domain.org>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key
# For older Supabase projects, use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# Use the same Clerk Production/Development instance as codewithpurpose.org.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# HMAC key used to keep CWP account IDs out of database state keys.
AUTH_SECRET=replace-with-at-least-32-random-characters
